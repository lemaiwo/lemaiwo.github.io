<mvc:View controllerName="be.wl.lemtech.wouter.controller.MCP"
    xmlns:mvc="sap.ui.core.mvc" displayBlock="true"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:core="sap.ui.core"
    xmlns:l="sap.ui.layout"
	height="100%" >

    <f:DynamicPage id="mcppage" class="sapUiNoContentPadding" >
        <f:content>
            <l:VerticalLayout width="100%">
                <Panel accessibleRole="Region" class="sapUiNoContentPadding" backgroundDesign="Transparent">
                    <l:BlockLayout>
                        <l:BlockLayoutRow>
                            <l:BlockLayoutCell
                                backgroundColorSet="ColorSet10"
                                backgroundColorShade="ShadeB">
                                <VBox alignItems="Center" class="sapUiLargeMarginTopBottom">
                                    <Avatar src="sap-icon://ai" displaySize="XL" displayShape="Circle" showBorder="true" backgroundColor="Accent6"/>
                                    <Title text="SAP &amp; AI" level="H1" titleStyle="H1" class="sapUiMediumMarginTop"/>
                                    <Text text="Bringing artificial intelligence to your SAP landscape" class="sapUiSmallMarginTop" textAlign="Center"/>
                                </VBox>
                            </l:BlockLayoutCell>
                        </l:BlockLayoutRow>
                    </l:BlockLayout>
                </Panel>
                <l:Grid
                    defaultSpan="XL8 L10 M12 S12"
                    hSpacing="0"
                    vSpacing="0">
                    <VBox alignItems="Center">
                        <layoutData>
                            <l:GridData span="XL2 L1 M12 S12"/>
                        </layoutData>
                    </VBox>
                    <l:VerticalLayout width="100%">
                        <Panel	accessibleRole="Region"
                                backgroundDesign="Translucent"
                                class="sapUiNoContentPadding">
                            <headerToolbar>
                                <Toolbar class="headlineCell">
                                    <Title width="100%"
                                        text="AI Meets Enterprise"
                                        level="H3"
                                        titleStyle="H3"
                                        class="sapUiMediumMarginTopBottom"/>
                                </Toolbar>
                            </headerToolbar>
                            <l:BlockLayout>
                                <l:BlockLayoutRow>
                                    <l:BlockLayoutCell
                                        backgroundColorSet="ColorSet10"
                                        backgroundColorShade="ShadeC">
                                        <VBox alignItems="Center">
                                            <Text
                                                text="AI is transforming how businesses interact with their data and systems. For SAP customers, this opens exciting possibilities: from natural language queries on business data to intelligent process automation and AI-assisted development."
                                                class="sapUiSmallMarginBottom"/>
                                            <Text
                                                text="I help organizations bridge the gap between cutting-edge AI capabilities and their SAP investments. Whether you want to enable AI agents to work with your SAP data, implement intelligent automation, or explore how AI can enhance your business processes, I bring the technical expertise to make it happen."
                                                class="sapUiSmallMarginBottom"/>
                                        </VBox>
                                    </l:BlockLayoutCell>
                                </l:BlockLayoutRow>
                            </l:BlockLayout>
                        </Panel>
                        <Panel	accessibleRole="Region"
                                backgroundDesign="Translucent"
                                class="sapUiNoContentPadding">
                            <headerToolbar>
                                <Toolbar class="headlineCell">
                                    <Title width="100%"
                                        text="What I Can Help You With"
                                        level="H3"
                                        titleStyle="H3"
                                        class="sapUiMediumMarginTopBottom"/>
                                </Toolbar>
                            </headerToolbar>
                            <FlexBox
                                alignItems="Start"
                                justifyContent="Center"
                                class="sapUiMediumMarginTop">
                                <l:Grid
                                    defaultSpan="XL4 L6 M6 S12"
                                    hSpacing="1"
                                    vSpacing="0"
                                    width="100%" >
                                    <HBox width="100%" justifyContent="Center">
                                        <HBox width="20rem" height="160px" justifyContent="Start" alignItems="Stretch" class="">
                                            <VBox justifyContent="Start" alignItems="Center">
                                                <Avatar src="sap-icon://connected" displaySize="M" displayShape="Circle" showBorder="false" backgroundColor="Accent6"/>
                                            </VBox>
                                            <VBox justifyContent="Start" alignItems="Stretch" class="sapUiTinyMarginBegin">
                                                <Title text="AI Agent Integration"></Title>
                                                <Text text="Enable AI assistants like Claude, ChatGPT, or Copilot to securely access and work with your SAP data."></Text>
                                            </VBox>
                                        </HBox>
                                    </HBox>
                                    <HBox width="100%" justifyContent="Center">
                                        <HBox width="20rem" height="160px" justifyContent="Start" alignItems="Stretch" class="">
                                            <VBox justifyContent="Start" alignItems="Center">
                                                <Avatar src="sap-icon://machine" displaySize="M" displayShape="Circle" showBorder="false" backgroundColor="Accent7"/>
                                            </VBox>
                                            <VBox justifyContent="Start" alignItems="Stretch" class="sapUiTinyMarginBegin">
                                                <Title text="Intelligent Automation"></Title>
                                                <Text text="Automate complex business processes by combining AI capabilities with SAP workflows and data."></Text>
                                            </VBox>
                                        </HBox>
                                    </HBox>
                                    <HBox width="100%" justifyContent="Center">
                                        <HBox width="20rem" height="160px" justifyContent="Start" alignItems="Stretch" class="">
                                            <VBox justifyContent="Start" alignItems="Center">
                                                <Avatar src="sap-icon://business-objects-experience" displaySize="M" displayShape="Circle" showBorder="false" backgroundColor="Accent8"/>
                                            </VBox>
                                            <VBox justifyContent="Start" alignItems="Stretch" class="sapUiTinyMarginBegin">
                                                <Title text="Data Analysis"></Title>
                                                <Text text="Use AI to analyze trends, identify patterns, and generate insights from your SAP business data."></Text>
                                            </VBox>
                                        </HBox>
                                    </HBox>
                                    <HBox width="100%" justifyContent="Center">
                                        <HBox width="20rem" height="160px" justifyContent="Start" alignItems="Stretch" class="">
                                            <VBox justifyContent="Start" alignItems="Center">
                                                <Avatar src="sap-icon://developer-settings" displaySize="M" displayShape="Circle" showBorder="false" backgroundColor="Accent9"/>
                                            </VBox>
                                            <VBox justifyContent="Start" alignItems="Stretch" class="sapUiTinyMarginBegin">
                                                <Title text="AI-Assisted Development"></Title>
                                                <Text text="Accelerate SAP development with AI coding assistants that understand your data models and services."></Text>
                                            </VBox>
                                        </HBox>
                                    </HBox>
                                    <HBox width="100%" justifyContent="Center">
                                        <HBox width="20rem" height="160px" justifyContent="Start" alignItems="Stretch" class="">
                                            <VBox justifyContent="Start" alignItems="Center">
                                                <Avatar src="sap-icon://shield" displaySize="M" displayShape="Circle" showBorder="false" backgroundColor="Accent10"/>
                                            </VBox>
                                            <VBox justifyContent="Start" alignItems="Stretch" class="sapUiTinyMarginBegin">
                                                <Title text="Enterprise Security"></Title>
                                                <Text text="Implement AI solutions with proper authentication, authorization, and data privacy controls."></Text>
                                            </VBox>
                                        </HBox>
                                    </HBox>
                                    <HBox width="100%" justifyContent="Center">
                                        <HBox width="20rem" height="160px" justifyContent="Start" alignItems="Stretch" class="">
                                            <VBox justifyContent="Start" alignItems="Center">
                                                <Avatar src="sap-icon://curriculum" displaySize="M" displayShape="Circle" showBorder="false" backgroundColor="Accent1"/>
                                            </VBox>
                                            <VBox justifyContent="Start" alignItems="Stretch" class="sapUiTinyMarginBegin">
                                                <Title text="AI Strategy"></Title>
                                                <Text text="Define a practical AI roadmap for your SAP landscape that delivers real business value."></Text>
                                            </VBox>
                                        </HBox>
                                    </HBox>
                                </l:Grid>
                            </FlexBox>
                        </Panel>
                        <Panel	accessibleRole="Region"
                                backgroundDesign="Translucent"
                                class="sapUiNoContentPadding">
                            <headerToolbar>
                                <Toolbar class="headlineCell">
                                    <Title width="100%"
                                        text="Featured: SAP MCP Server"
                                        level="H3"
                                        titleStyle="H3"
                                        class="sapUiMediumMarginTopBottom"/>
                                </Toolbar>
                            </headerToolbar>
                            <l:BlockLayout>
                                <l:BlockLayoutRow>
                                    <l:BlockLayoutCell
                                        backgroundColorSet="ColorSet10"
                                        backgroundColorShade="ShadeD">
                                        <VBox alignItems="Center" class="sapUiSmallMarginBottom">
                                            <Text
                                                text="One of my open-source projects that demonstrates the power of combining SAP with modern AI. The SAP MCP Server uses the Model Context Protocol to connect any SAP system with AI agents."
                                                class="sapUiSmallMarginBottom"/>
                                        </VBox>
                                        <l:Grid
                                            defaultSpan="XL6 L6 M12 S12"
                                            hSpacing="1"
                                            vSpacing="0"
                                            width="100%" >
                                            <VBox class="sapUiSmallMarginBottom">
                                                <Title text="How it works" level="H5" class="sapUiSmallMarginBottom"/>
                                                <HBox>
                                                    <core:Icon src="sap-icon://accept" size="1rem" color="Default" class="sapUiTinyMarginBegin sapUiSmallMarginEnd"/>
                                                    <Text width="100%" text="Connects to SAP ECC, S/4HANA, or any OData-enabled system"/>
                                                </HBox>
                                                <HBox>
                                                    <core:Icon src="sap-icon://accept" size="1rem" color="Default" class="sapUiTinyMarginBegin sapUiSmallMarginEnd"/>
                                                    <Text width="100%" text="Deploys on SAP BTP with enterprise-grade security"/>
                                                </HBox>
                                                <HBox>
                                                    <core:Icon src="sap-icon://accept" size="1rem" color="Default" class="sapUiTinyMarginBegin sapUiSmallMarginEnd"/>
                                                    <Text width="100%" text="Works with Claude, Cursor, and other MCP-compatible AI tools"/>
                                                </HBox>
                                            </VBox>
                                            <VBox class="sapUiSmallMarginBottom">
                                                <Title text="What you can do" level="H5" class="sapUiSmallMarginBottom"/>
                                                <HBox>
                                                    <core:Icon src="sap-icon://accept" size="1rem" color="Default" class="sapUiTinyMarginBegin sapUiSmallMarginEnd"/>
                                                    <Text width="100%" text="Query SAP data using natural language"/>
                                                </HBox>
                                                <HBox>
                                                    <core:Icon src="sap-icon://accept" size="1rem" color="Default" class="sapUiTinyMarginBegin sapUiSmallMarginEnd"/>
                                                    <Text width="100%" text="Analyze business data with AI assistance"/>
                                                </HBox>
                                                <HBox>
                                                    <core:Icon src="sap-icon://accept" size="1rem" color="Default" class="sapUiTinyMarginBegin sapUiSmallMarginEnd"/>
                                                    <Text width="100%" text="Accelerate development with SAP-aware AI coding"/>
                                                </HBox>
                                            </VBox>
                                        </l:Grid>
                                        <VBox alignItems="Center" class="sapUiMediumMarginTop">
                                            <Text text="The basic version is available as open source. An advanced enterprise version with additional features is also available." class="sapUiSmallMarginBottom" textAlign="Center"/>
                                            <HBox justifyContent="Center" class="sapUiSmallMarginTop">
                                                <Button text="View on GitHub" icon="sap-icon://developer-settings" type="Emphasized" press=".onOpenGitHub" class="sapUiSmallMarginEnd"/>
                                            </HBox>
                                        </VBox>
                                    </l:BlockLayoutCell>
                                </l:BlockLayoutRow>
                            </l:BlockLayout>
                        </Panel>
                        <Panel	accessibleRole="Region"
                                backgroundDesign="Translucent"
                                class="sapUiNoContentPadding">
                            <l:BlockLayout>
                                <l:BlockLayoutRow>
                                    <l:BlockLayoutCell
                                        backgroundColorSet="ColorSet10"
                                        backgroundColorShade="ShadeB">
                                        <VBox alignItems="Center" class="sapUiMediumMarginTopBottom">
                                            <Title text="Ready to explore AI for your SAP landscape?" level="H3" class="sapUiSmallMarginBottom"/>
                                            <Text text="Let's discuss how AI can enhance your SAP investments and create new possibilities for your business." class="sapUiSmallMarginBottom" textAlign="Center"/>
                                            <Button text="Get in Touch" icon="sap-icon://email" type="Emphasized" press=".onContact" class="sapUiMediumMarginTop"/>
                                        </VBox>
                                    </l:BlockLayoutCell>
                                </l:BlockLayoutRow>
                            </l:BlockLayout>
                        </Panel>
                        <Panel class="sapUiNoContentPadding">
                            <l:BlockLayout>
                                <l:BlockLayoutRow>
                                    <l:BlockLayoutCell
                                        backgroundColorSet="ColorSet10"
                                        backgroundColorShade="ShadeE">
                                        <VBox alignItems="Center">
                                        </VBox>
                                    </l:BlockLayoutCell>
                                </l:BlockLayoutRow>
                            </l:BlockLayout>
                        </Panel>
                    </l:VerticalLayout>
                </l:Grid>
            </l:VerticalLayout>
        </f:content>
    </f:DynamicPage>
</mvc:View>
