<mvc:View controllerName="be.wl.lemtech.wouter.controller.Home"
    xmlns:mvc="sap.ui.core.mvc" displayBlock="true"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:l="sap.ui.layout"
    xmlns:f="sap.f">
   <f:DynamicPage id="homepage" showFooter="false" class="sapUiNoContentPadding">
        <f:content>
            <l:Grid
                    defaultSpan="XL8 L10 M12 S12"
                    hSpacing="0"
                    vSpacing="0">
                    <VBox alignItems="Center">
                        <layoutData>
                            <l:GridData span="XL2 L1 M12 S12"/>
                        </layoutData>
                    </VBox>
            <l:VerticalLayout width="100%">
            <Panel	accessibleRole="Region"
                    backgroundDesign="Transparent"
                    class="sapUiNoContentPadding">
                <l:BlockLayout>
                    <l:BlockLayoutRow>
                        <l:BlockLayoutCell
                                backgroundColorSet="ColorSet10"
                                backgroundColorShade="ShadeB">
                                    <VBox alignItems="Center">
                                        <Avatar src="dist/images/image002.jpg" displaySize="XL" press=".onAvatarPressed" displayShape="Circle" showBorder="true" tooltip="Profile" class="sapUiSmallMarginTop">
                                        <detailBox>
                                            <LightBox>
                                                <LightBoxItem
                                                        imageSrc="dist/images/image002.jpg"
                                                        alt="Wouter Lemaire"
                                                        title="Wouter Lemaire"
                                                        subtitle="SAP Solution Architect, Developer &amp; SAP Mentor">
                                                </LightBoxItem>
                                            </LightBox>
                                        </detailBox>
                                        </Avatar>
                                        <Title width="100%"
                                                text="Wouter Lemaire"
                                                level="H1"
                                                titleStyle="H1"
                                                class="sapUiSmallMarginTop"/>
                                        <Text text="SAP Solution Architect &amp; Developer" class="sapUiTinyMarginTop"/>
                                        <Text text="SAP Mentor | SAP Certified" class="sapUiTinyMarginTop sapUiSmallMarginBottom"/>
                                    </VBox>
                        </l:BlockLayoutCell>
                        <l:BlockLayoutCell
                                backgroundColorSet="ColorSet10"
                                backgroundColorShade="ShadeC">
                                    <VBox alignItems="Center" class="sapUiMediumMarginTopBottom">
                                    <l:VerticalLayout>
                                        <Text
                                            text="Helping organizations unlock the full potential of SAP through expert architecture, hands-on development, and strategic guidance."
                                            class="sapUiSmallMarginBottom"/>
                                        <Text
                                            text="With over a decade of experience across BTP, Fiori, UI5, CAP, and ABAP, I bring proven solutions from enterprise projects at leading European organizations. From strategy to implementation, I ensure your SAP investments deliver real business value."
                                            class="sapUiSmallMarginBottom"/>
                                        <HBox class="sapUiMediumMarginTop">
                                            <Button text="Get in Touch" type="Emphasized" press=".onContact" icon="sap-icon://email" class="sapUiSmallMarginEnd"/>
                                            <Button text="About Me" type="Default" press=".onNavigateTo('me')" icon="sap-icon://person-placeholder"/>
                                        </HBox>
                                    </l:VerticalLayout>
                                    </VBox>
                        </l:BlockLayoutCell>
                    </l:BlockLayoutRow>
                </l:BlockLayout>
            </Panel>
            <Panel	accessibleRole="Region"
                    backgroundDesign="Transparent"
                    class="sapUiNoContentPadding">
                <headerToolbar>
                    <Toolbar class="headlineCell">
                        <Title width="100%"
                            text="Areas of Expertise"
                            level="H3"
                            titleStyle="H3"
                            class="sapUiMediumMarginTopBottom"/>
                    </Toolbar>
                </headerToolbar>
                <l:BlockLayout>
                    <l:BlockLayoutRow>
                        <l:BlockLayoutCell
                            backgroundColorSet="ColorSet10"
                            backgroundColorShade="ShadeC">
                            <VBox alignItems="Center">
                                <Avatar src="sap-icon://cloud" displaySize="XL" press=".onNavigateTo('btp')" displayShape="Circle" showBorder="true" tooltip="BTP Architecture" backgroundColor="Accent6">
                                </Avatar>
                                <Title width="100%"
                                        text="BTP Architecture"
                                        level="H4"
                                        wrapping="true"
                                        class="sapUiSmallMarginTop"/>
                                <Text text="Governance, security, integration, and application development on SAP Business Technology Platform" textAlign="Center" class="sapUiTinyMarginTop"/>
                                <Link text="Learn more" press=".onNavigateTo('btp')" class="sapUiSmallMarginTop"/>
                            </VBox>
                        </l:BlockLayoutCell>
                        <l:BlockLayoutCell
                                backgroundColorSet="ColorSet10"
                                backgroundColorShade="ShadeD">
                            <VBox alignItems="Center">
                                <Avatar src="sap-icon://desktop-mobile" displaySize="XL" press=".onNavigateTo('fiori')" displayShape="Circle" showBorder="true" tooltip="Fiori &amp; WorkZone" backgroundColor="Accent7">
                                </Avatar>
                                <Title width="100%"
                                        text="Fiori &amp; WorkZone"
                                        level="H4"
                                        titleStyle="H4"
                                        wrapping="true"
                                        class="sapUiSmallMarginTop"/>
                                <Text text="Central Launchpad strategy, UX design, governance, and Fiori application development" textAlign="Center" class="sapUiTinyMarginTop"/>
                                <Link text="Learn more" press=".onNavigateTo('fiori')" class="sapUiSmallMarginTop"/>
                            </VBox>
                        </l:BlockLayoutCell>
                        <l:BlockLayoutCell
                                backgroundColorSet="ColorSet10"
                                backgroundColorShade="ShadeE">
                            <VBox alignItems="Center">
                                <Avatar src="sap-icon://ai" displaySize="XL" press=".onNavigateTo('mcp')" displayShape="Circle" showBorder="true" tooltip="SAP &amp; AI" backgroundColor="Accent8">
                                </Avatar>
                                <Title width="100%"
                                        text="SAP &amp; AI"
                                        level="H4"
                                        titleStyle="H4"
                                        wrapping="true"
                                        class="sapUiSmallMarginTop"/>
                                <Text text="Leverage AI to enhance your SAP landscape with intelligent automation, data analysis, and AI-powered integrations" textAlign="Center" class="sapUiTinyMarginTop"/>
                                <Link text="Learn more" press=".onNavigateTo('mcp')" class="sapUiSmallMarginTop"/>
                            </VBox>
                        </l:BlockLayoutCell>
                    </l:BlockLayoutRow>
                </l:BlockLayout>
            </Panel>
            <Panel	accessibleRole="Region"
                    backgroundDesign="Transparent"
                    class="sapUiNoContentPadding">
                <headerToolbar>
                    <Toolbar class="headlineCell">
                        <Title width="100%"
                            text="How I Can Help"
                            level="H3"
                            titleStyle="H3"
                            class="sapUiMediumMarginTopBottom"/>
                    </Toolbar>
                </headerToolbar>
                <l:BlockLayout>
                    <l:BlockLayoutRow>
                        <l:BlockLayoutCell
                            backgroundColorSet="ColorSet10"
                            backgroundColorShade="ShadeB">
                            <FlexBox
                                alignItems="Start"
                                justifyContent="Center"
                                class="sapUiMediumMarginTopBottom">
                                <l:Grid
                                    defaultSpan="XL4 L6 M6 S12"
                                    hSpacing="1"
                                    vSpacing="0"
                                    width="100%" >
                                    <HBox width="100%" justifyContent="Center">
                                        <HBox width="20rem" justifyContent="Start" alignItems="Stretch" class="sapUiSmallMarginTopBottom">
                                            <VBox justifyContent="Start" alignItems="Center">
                                                <Avatar src="sap-icon://physical-activity" displaySize="M" displayShape="Circle" showBorder="false" backgroundColor="Accent6"/>
                                            </VBox>
                                            <VBox justifyContent="Start" alignItems="Stretch" class="sapUiTinyMarginBegin">
                                                <Title text="Architecture &amp; Strategy"/>
                                                <Text text="Design your SAP technology landscape with a clear roadmap that aligns with your business objectives."/>
                                            </VBox>
                                        </HBox>
                                    </HBox>
                                    <HBox width="100%" justifyContent="Center">
                                        <HBox width="20rem" justifyContent="Start" alignItems="Stretch" class="sapUiSmallMarginTopBottom">
                                            <VBox justifyContent="Start" alignItems="Center">
                                                <Avatar src="sap-icon://syntax" displaySize="M" displayShape="Circle" showBorder="false" backgroundColor="Accent7"/>
                                            </VBox>
                                            <VBox justifyContent="Start" alignItems="Stretch" class="sapUiTinyMarginBegin">
                                                <Title text="Custom Development"/>
                                                <Text text="Build tailored applications using CAP, UI5, Fiori Elements, and ABAP RAP that solve your specific business challenges."/>
                                            </VBox>
                                        </HBox>
                                    </HBox>
                                    <HBox width="100%" justifyContent="Center">
                                        <HBox width="20rem" justifyContent="Start" alignItems="Stretch" class="sapUiSmallMarginTopBottom">
                                            <VBox justifyContent="Start" alignItems="Center">
                                                <Avatar src="sap-icon://learning-assistant" displaySize="M" displayShape="Circle" showBorder="false" backgroundColor="Accent8"/>
                                            </VBox>
                                            <VBox justifyContent="Start" alignItems="Stretch" class="sapUiTinyMarginBegin">
                                                <Title text="Team Enablement"/>
                                                <Text text="Accelerate your team's capabilities through hands-on mentoring, code reviews, and knowledge transfer."/>
                                            </VBox>
                                        </HBox>
                                    </HBox>
                                    <HBox width="100%" justifyContent="Center">
                                        <HBox width="20rem" justifyContent="Start" alignItems="Stretch" class="sapUiSmallMarginTopBottom">
                                            <VBox justifyContent="Start" alignItems="Center">
                                                <Avatar src="sap-icon://official-service" displaySize="M" displayShape="Circle" showBorder="false" backgroundColor="Accent9"/>
                                            </VBox>
                                            <VBox justifyContent="Start" alignItems="Stretch" class="sapUiTinyMarginBegin">
                                                <Title text="Governance"/>
                                                <Text text="Establish frameworks and standards that ensure consistency, security, and maintainability across your SAP landscape."/>
                                            </VBox>
                                        </HBox>
                                    </HBox>
                                    <HBox width="100%" justifyContent="Center">
                                        <HBox width="20rem" justifyContent="Start" alignItems="Stretch" class="sapUiSmallMarginTopBottom">
                                            <VBox justifyContent="Start" alignItems="Center">
                                                <Avatar src="sap-icon://combine" displaySize="M" displayShape="Circle" showBorder="false" backgroundColor="Accent10"/>
                                            </VBox>
                                            <VBox justifyContent="Start" alignItems="Stretch" class="sapUiTinyMarginBegin">
                                                <Title text="Integration"/>
                                                <Text text="Seamlessly connect your cloud and on-premise systems to create a unified SAP ecosystem."/>
                                            </VBox>
                                        </HBox>
                                    </HBox>
                                    <HBox width="100%" justifyContent="Center">
                                        <HBox width="20rem" justifyContent="Start" alignItems="Stretch" class="sapUiSmallMarginTopBottom">
                                            <VBox justifyContent="Start" alignItems="Center">
                                                <Avatar src="sap-icon://developer-settings" displaySize="M" displayShape="Circle" showBorder="false" backgroundColor="Accent1"/>
                                            </VBox>
                                            <VBox justifyContent="Start" alignItems="Stretch" class="sapUiTinyMarginBegin">
                                                <Title text="DevOps"/>
                                                <Text text="Implement automated pipelines and testing strategies that reduce risk and accelerate delivery."/>
                                            </VBox>
                                        </HBox>
                                    </HBox>
                                </l:Grid>
                            </FlexBox>
                        </l:BlockLayoutCell>
                    </l:BlockLayoutRow>
                </l:BlockLayout>
            </Panel>
            <Panel	accessibleRole="Region"
                    backgroundDesign="Transparent"
                    class="sapUiNoContentPadding">
                <l:BlockLayout>
                    <l:BlockLayoutRow>
                        <l:BlockLayoutCell
                            backgroundColorSet="ColorSet10"
                            backgroundColorShade="ShadeC">
                            <VBox alignItems="Center" class="sapUiMediumMarginTopBottom">
                                <Title text="Ready to discuss your project?" level="H3" class="sapUiSmallMarginBottom"/>
                                <Text text="Whether you need architectural guidance, hands-on development, or team mentoring, I'm here to help." class="sapUiSmallMarginBottom" textAlign="Center"/>
                                <Button text="Get in Touch" type="Emphasized" press=".onContact" icon="sap-icon://email" class="sapUiMediumMarginTop"/>
                            </VBox>
                        </l:BlockLayoutCell>
                    </l:BlockLayoutRow>
                    <l:BlockLayoutRow>
                        <l:BlockLayoutCell
                            backgroundColorSet="ColorSet10"
                            backgroundColorShade="ShadeE">
                            <VBox alignItems="Center">
                            </VBox>
                        </l:BlockLayoutCell>
                    </l:BlockLayoutRow>
                </l:BlockLayout>
            </Panel>
             </l:VerticalLayout>
                </l:Grid>
        </f:content>
    </f:DynamicPage>
</mvc:View>
