<mvc:View controllerName="be.wl.lemtech.wouter.controller.AboutMe"
    xmlns:mvc="sap.ui.core.mvc" displayBlock="true"
    xmlns="sap.m" 
    xmlns:core="sap.ui.core"
    xmlns:l="sap.ui.layout"
    xmlns:f="sap.f">
   <f:DynamicPage id="homepage" showFooter="false" class="sapUiNoContentPadding">
        <f:content>
            <l:Grid
                    defaultSpan="XL10 L10 M12 S12"
                    hSpacing="0"
                    vSpacing="0">
                    <VBox alignItems="Center">
                        <layoutData>
                            <l:GridData span="XL1 L1 M12 S12"/>
                        </layoutData>
                    </VBox>
            <l:BlockLayout>
                <l:BlockLayoutRow>
                    <l:BlockLayoutCell
                            backgroundColorSet="ColorSet10"
                            backgroundColorShade="ShadeB"
                            title="">
                            <VBox alignItems="Center">
                                <Avatar src="dist/images/image002.jpg" displaySize="Custom" customDisplaySize="20rem" press=".onAvatarPressed" displayShape="Circle" showBorder="true" tooltip="Profile">
                                    <detailBox>
                                        <LightBox>
                                            <LightBoxItem
                                                    imageSrc="dist/images/image002.jpg"
                                                    alt="Wouter Lemaire"
                                                    title="Wouter Lemaire"
                                                    subtitle="SAP Solution Architect, Developer &amp; part of SAP Mentors">
                                            </LightBoxItem>
                                        </LightBox>
                                    </detailBox>
                                    <!-- <layoutData>
                                        <OverflowToolbarLayoutData priority="NeverOverflow"/>
                                    </layoutData> -->
                                </Avatar>
                                <Title width="100%"
                                            level="H5"
                                            titleStyle="H5"
                                            text="Follow me on:"
                                            class="sapUiSmallMarginTopBottom">
                                        </Title>
                                <HBox >
                                    <Image src="./dist/images/github.png" width="50px" press=".onOpenFollowMeOn('https://github.com/lemaiwo')" class="sapUiTinyMarginBegin sapUiSmallMarginEnd"></Image>
                                    <Image src="./dist/images/xlogoblack.png" width="50px" press=".onOpenFollowMeOn('https://twitter.com/wouter_lemaire')" class="sapUiTinyMarginBegin sapUiSmallMarginEnd"></Image>
                                    <Image src="./dist/images/linkedin.png" width="50px" press=".onOpenFollowMeOn('https://www.linkedin.com/in/wouterlemaire')" class="sapUiTinyMarginBegin sapUiSmallMarginEnd"></Image>
                                    <Image src="./dist/images/sap.png" width="100px" press=".onOpenFollowMeOn('https://community.sap.com/t5/user/viewprofilepage/user-id/9863')" class="sapUiTinyMarginBegin sapUiSmallMarginEnd"></Image>
                                </HBox>
                            </VBox>
                    </l:BlockLayoutCell>
                    <l:BlockLayoutCell
                            backgroundColorSet="ColorSet10"
                            backgroundColorShade="ShadeC"
                            title="Bio">
                                <l:VerticalLayout
                                        width="100%">
                                    <Text
                                            text="I'm an independent SAP solution architect and developer with over a decade of hands-on experience. I've been building with SAP technologies since the ABAP WebDynpro days, and was an early adopter of UI5 and Fiori when they first launched. My journey has taken me from pure development into architecture, though I still love combining both. Today I focus on helping organizations succeed with:"
                                            class="sapUiSmallMarginBottom"/>
                                    <HBox>
                                        <core:Icon
                                                src="sap-icon://cloud"
                                                size="1rem"
                                                color="Default"
                                                class="sapUiTinyMarginBegin sapUiSmallMarginEnd sapUiSmallMarginTopBottom"/>
                                        <Title width="100%"
                                            level="H5"
                                            titleStyle="H5"
                                            class="sapUiSmallMarginTopBottom">
                                            <Link text="Business Technology Platform (BTP)" press=".onNavigateTo('btp')" />
                                        </Title>
                                    </HBox><HBox>
                                        <core:Icon
                                                src="sap-icon://desktop-mobile"
                                                size="1rem"
                                                color="Default"
                                                class="sapUiTinyMarginBegin sapUiSmallMarginEnd sapUiSmallMarginTopBottom"/>
                                        <Title width="100%"
                                            level="H5"
                                            titleStyle="H5"
                                            class="sapUiSmallMarginTopBottom">
                                            <Link text="Fiori Launchpad &amp; WorkZone" press=".onNavigateTo('fiori')" />
                                        </Title>
                                    </HBox><HBox>
                                        <core:Icon
                                                src="sap-icon://syntax"
                                                size="1rem"
                                                color="Default"
                                                class="sapUiTinyMarginBegin sapUiSmallMarginEnd sapUiSmallMarginTopBottom"/>
                                        <Title width="100%"
                                            level="H5"
                                            titleStyle="H5"
                                            text="Cloud Application Programming model"
                                            class="sapUiSmallMarginTopBottom">
                                            <!-- <Link text="Cloud Application Programming model" press=".onNavigateTo('cap')" /> -->
                                        </Title>
                                    </HBox><HBox>
                                        <core:Icon
                                                src="sap-icon://sap-ui5"
                                                size="1rem"
                                                color="Default"
                                                class="sapUiTinyMarginBegin sapUiSmallMarginEnd sapUiSmallMarginTopBottom"/>
                                        <Title width="100%"
                                            level="H5"
                                            text="SAPUI5 &amp; Fiori Elements"
                                            titleStyle="H5"
                                            class="sapUiSmallMarginTopBottom">
                                            <!-- <Link text="SAPUI5" press=".onNavigateTo('sapui5')" /> -->
                                        </Title>
                                    </HBox><HBox>
                                        <core:Icon
                                                src="sap-icon://syntax"
                                                size="1rem"
                                                color="Default"
                                                class="sapUiTinyMarginBegin sapUiSmallMarginEnd sapUiSmallMarginTopBottom"/>
                                        <Title width="100%"
                                            level="H5"
                                            titleStyle="H5"
                                            text="ABAP RESTful Application Programming"
                                            class="sapUiSmallMarginTopBottom">
                                            <!-- <Link text="Cloud Application Programming model" press=".onNavigateTo('cap')" /> -->
                                        </Title>
                                    </HBox>
                                </l:VerticalLayout>
                    </l:BlockLayoutCell>
                </l:BlockLayoutRow>
                <l:BlockLayoutRow>
                    <l:BlockLayoutCell
                            backgroundColorSet="ColorSet10"
                            backgroundColorShade="ShadeD"
                            title="SAP Certified">
                                <List >
                                    <items>
                                        <StandardListItem
                                            title="SAP Fiori Application Developer"
                                            icon="./dist/images/certfiori.png"
                                            iconDensityAware="false"
                                            iconInset="false"
                                            type="Active"
                                            press=".onOpenURL('https://www.credly.com/badges/29e525b7-f712-4ed0-8ccb-8d04da57d90f')"/>
                                        <StandardListItem
                                            title="SAP Cloud SDK Extensibility Developer"
                                            icon="./dist/images/cloudsdkcert.png"
                                            iconDensityAware="false"
                                            iconInset="false"
                                            type="Active"
                                            press=".onOpenURL('https://www.credly.com/badges/f2fdd537-d40b-4204-9756-3eb9dad47e60')"/>
                                        <StandardListItem
                                            title="SAP HANA Cloud"
                                            icon="./dist/images/hanacloudcert.png"
                                            iconDensityAware="false"
                                            iconInset="false"
                                            type="Active"
                                            press=".onOpenURL('https://www.credly.com/badges/dd8aa64f-1562-4a1b-b900-4bb93cdfa32f')"/>
                                        <StandardListItem
                                            title="SAP Extension Suite"
                                            icon="./dist/images/extcert.png"
                                            iconDensityAware="false"
                                            iconInset="false"
                                            type="Active"
                                            press=".onOpenURL('https://www.credly.com/badges/dbdd5d3b-dc5a-4477-8019-7c32c23cdab7')"/>
                                    </items>
                                </List>
                    </l:BlockLayoutCell>
                    <l:BlockLayoutCell
                            backgroundColorSet="ColorSet10"
                            backgroundColorShade="ShadeE"
                            title="Trusted By">
                                <VBox alignItems="Center" class="sapUiMediumMarginTopBottom">
                                    <Text text="I've delivered solutions for leading organizations across Europe" class="sapUiSmallMarginBottom" textAlign="Center"/>
                                    <HBox justifyContent="Center" alignItems="Center" wrap="Wrap" class="sapUiMediumMarginTop">
                                        <Image height="45px" src="./dist/images/ypto.png" class="sapUiMediumMarginEnd sapUiSmallMarginBottom" tooltip="Ypto"/>
                                        <Image height="45px" src="./dist/images/ec.png" class="sapUiMediumMarginEnd sapUiSmallMarginBottom" tooltip="European Commission"/>
                                        <Image height="45px" src="./dist/images/bayer.png" class="sapUiMediumMarginEnd sapUiSmallMarginBottom" tooltip="Bayer"/>
                                        <Image height="45px" src="./dist/images/fluvius.png" class="sapUiMediumMarginEnd sapUiSmallMarginBottom" tooltip="Fluvius"/>
                                        <Image height="45px" src="./dist/images/eliagroup.png" class="sapUiSmallMarginBottom" tooltip="Elia Group"/>
                                    </HBox>
                                </VBox>
                    </l:BlockLayoutCell>
                </l:BlockLayoutRow>
                <l:BlockLayoutRow>
                    <l:BlockLayoutCell
                            backgroundColorSet="ColorSet10"
                            backgroundColorShade="ShadeB"
                            title="SAP Community - Latest blog posts">
                                <List >
                                    <items>
                                        <StandardListItem
                                            title="Upload attachments in a Freestyle UI5 and CAP app"
                                            iconDensityAware="false"
                                            iconInset="false"
                                            type="Active"
                                            press=".onOpenURL('https://blogs.sap.com/?p=1895186')"/>
                                        <StandardListItem
                                            title="Extending legacy Fiori apps in BAS"
                                            iconDensityAware="false"
                                            iconInset="false"
                                            type="Active"
                                            press=".onOpenURL('https://blogs.sap.com/?p=1876919')"/>
                                        <StandardListItem
                                            title="Connecting UI5 Components in BTP CloudFoundry"
                                            iconDensityAware="false"
                                            iconInset="false"
                                            type="Active"
                                            press=".onOpenURL('https://blogs.sap.com/?p=1872088')"/>
                                        <StandardListItem
                                            title="UI5 TypeScript Component Architecture"
                                            iconDensityAware="false"
                                            iconInset="false"
                                            type="Active"
                                            press=".onOpenURL('https://blogs.sap.com/?p=1872034')"/>
                                        <StandardListItem
                                            title="View all posts on SAP Community"
                                            icon="sap-icon://arrow-right"
                                            iconDensityAware="false"
                                            iconInset="false"
                                            type="Active"
                                            press=".onOpenURL('https://community.sap.com/t5/user/viewprofilepage/user-id/9863')"/>
                                    </items>
                                </List>
                    </l:BlockLayoutCell>
                    <l:BlockLayoutCell
                            backgroundColorSet="ColorSet10"
                            backgroundColorShade="ShadeC"
                            title="Speaker at SAP Events">
                                <VBox alignItems="Center" class="sapUiMediumMarginTopBottom">
                                    <Text text="Regular speaker at major SAP community events" class="sapUiSmallMarginBottom" textAlign="Center"/>
                                    <HBox justifyContent="Center" alignItems="Center" wrap="Wrap" class="sapUiMediumMarginTop">
                                        <Image height="40px" src="./dist/images/sitbe.png" class="sapUiMediumMarginEnd sapUiSmallMarginBottom" tooltip="SAP Inside Track Belgium" press=".onOpenURL('https://sitbe.fiddle.be/')"/>
                                        <Image height="40px" src="./dist/images/recap.png" class="sapUiMediumMarginEnd sapUiSmallMarginBottom" tooltip="reCAP Conference" press=".onOpenURL('https://recap-conf.dev/')"/>
                                        <Image height="40px" src="./dist/images/UI5con.png" class="sapUiSmallMarginBottom" tooltip="UI5con" press=".onOpenURL('https://openui5.org/ui5con/')"/>
                                    </HBox>
                                </VBox>
                    </l:BlockLayoutCell>
                </l:BlockLayoutRow>
                <l:BlockLayoutRow>
                    <l:BlockLayoutCell
                            backgroundColorSet="ColorSet10"
                            backgroundColorShade="ShadeD">
                        <VBox alignItems="Center" class="sapUiMediumMarginTopBottom">
                            <Title text="Let's Work Together" level="H3" class="sapUiSmallMarginBottom"/>
                            <Text text="Have a project in mind or need help with SAP technologies? I'd love to hear from you." class="sapUiSmallMarginBottom" textAlign="Center"/>
                            <HBox justifyContent="Center" class="sapUiMediumMarginTop">
                                <Button text="Email Me" type="Emphasized" press=".onContact" icon="sap-icon://email" class="sapUiSmallMarginEnd"/>
                                <Button text="LinkedIn" type="Default" press=".onOpenFollowMeOn('https://www.linkedin.com/in/wouterlemaire')" icon="sap-icon://visits"/>
                            </HBox>
                        </VBox>
                    </l:BlockLayoutCell>
                </l:BlockLayoutRow>
                <l:BlockLayoutRow>
                    <l:BlockLayoutCell
                            backgroundColorSet="ColorSet10"
                            backgroundColorShade="ShadeE">
                        <VBox alignItems="Center">
                        </VBox>
                    </l:BlockLayoutCell>
                </l:BlockLayoutRow>
            </l:BlockLayout>
            </l:Grid>
        </f:content>
    </f:DynamicPage>
</mvc:View>
