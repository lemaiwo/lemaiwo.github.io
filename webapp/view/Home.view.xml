<mvc:View controllerName="be.wl.lemtech.wouter.controller.Home"
    xmlns:mvc="sap.ui.core.mvc" displayBlock="true"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:l="sap.ui.layout"
    xmlns:f="sap.f">
   <f:DynamicPage id="homepage" showFooter="false" class="sapUiNoContentPadding">
        <f:content>
            <l:Grid
                    defaultSpan="XL8 L10 M12 S12"
                    hSpacing="0"
                    vSpacing="0">
                    <VBox alignItems="Center">
                        <layoutData>
                            <l:GridData span="XL2 L1 M12 S12"/>
                        </layoutData>
                    </VBox>
            <l:VerticalLayout width="100%">
            <Panel	accessibleRole="Region"
                    backgroundDesign="Transparent"
                    class="sapUiNoContentPadding">
                <l:BlockLayout>
                    <l:BlockLayoutRow>
                        <l:BlockLayoutCell
                                backgroundColorSet="ColorSet10"
                                backgroundColorShade="ShadeB">
                                    <VBox alignItems="Center">
                                        <Avatar src="dist/images/image002.jpg" displaySize="XL" press=".onAvatarPressed" displayShape="Circle" showBorder="true" tooltip="Profile" class="sapUiSmallMarginTop">
                                        <detailBox>
                                            <LightBox>
                                                <LightBoxItem
                                                        imageSrc="dist/images/image002.jpg"
                                                        alt="Wouter Lemaire"
                                                        title="Wouter Lemaire"
                                                        subtitle="SAP Solution Architect, Developer &amp; SAP Mentor">
                                                </LightBoxItem>
                                            </LightBox>
                                        </detailBox>
                                        </Avatar>
                                        <Title width="100%"
                                                text="Wouter Lemaire"
                                                level="H1"
                                                titleStyle="H1"
                                                class="sapUiSmallMarginTop"/>
                                        <Text text="SAP Solution Architect &amp; Developer" class="sapUiTinyMarginTop"/>
                                        <Text text="SAP Mentor | SAP Certified" class="sapUiTinyMarginTop sapUiSmallMarginBottom"/>
                                    </VBox>
                        </l:BlockLayoutCell>
                        <l:BlockLayoutCell
                                backgroundColorSet="ColorSet10"
                                backgroundColorShade="ShadeC">
                                    <VBox alignItems="Center" class="sapUiMediumMarginTopBottom">
                                    <l:VerticalLayout>
                                        <Text
                                            text="I help organizations get the most out of their SAP investments through architecture, development, and strategic guidance."
                                            class="sapUiSmallMarginBottom"/>
                                        <Text
                                            text="With over 10 years of experience in the SAP ecosystem, I specialize in BTP, Fiori/WorkZone, UI5, CAP, and ABAP. I combine deep technical expertise with practical experience from working with enterprise customers across Europe."
                                            class="sapUiSmallMarginBottom"/>
                                        <HBox class="sapUiMediumMarginTop">
                                            <Button text="Get in Touch" type="Emphasized" press=".onContact" icon="sap-icon://email" class="sapUiSmallMarginEnd"/>
                                            <Button text="About Me" type="Default" press=".onNavigateTo('me')" icon="sap-icon://person-placeholder"/>
                                        </HBox>
                                    </l:VerticalLayout>
                                    </VBox>
                        </l:BlockLayoutCell>
                    </l:BlockLayoutRow>
                </l:BlockLayout>
            </Panel>
            <Panel	accessibleRole="Region"
                    backgroundDesign="Transparent"
                    class="sapUiNoContentPadding">
                <headerToolbar>
                    <Toolbar class="headlineCell">
                        <Title width="100%"
                            text="Areas of Expertise"
                            level="H3"
                            titleStyle="H3"
                            class="sapUiMediumMarginTopBottom"/>
                    </Toolbar>
                </headerToolbar>
                <l:BlockLayout>
                    <l:BlockLayoutRow>
                        <l:BlockLayoutCell
                            backgroundColorSet="ColorSet10"
                            backgroundColorShade="ShadeC">
                            <VBox alignItems="Center">
                                <Avatar src="sap-icon://cloud" displaySize="XL" press=".onNavigateTo('btp')" displayShape="Circle" showBorder="true" tooltip="BTP Architecture">
                                </Avatar>
                                <Title width="100%"
                                        text="BTP Architecture"
                                        level="H4"
                                        wrapping="true"
                                        class="sapUiSmallMarginTop"/>
                                <Text text="Governance, security, integration, and application development on SAP Business Technology Platform" textAlign="Center" class="sapUiTinyMarginTop"/>
                                <Link text="Learn more" press=".onNavigateTo('btp')" class="sapUiSmallMarginTop"/>
                            </VBox>
                        </l:BlockLayoutCell>
                        <l:BlockLayoutCell
                                backgroundColorSet="ColorSet10"
                                backgroundColorShade="ShadeD">
                            <VBox alignItems="Center">
                                <Avatar src="sap-icon://desktop-mobile" displaySize="XL" press=".onNavigateTo('fiori')" displayShape="Circle" showBorder="true" tooltip="Fiori &amp; WorkZone">
                                </Avatar>
                                <Title width="100%"
                                        text="Fiori &amp; WorkZone"
                                        level="H4"
                                        titleStyle="H4"
                                        wrapping="true"
                                        class="sapUiSmallMarginTop"/>
                                <Text text="Central Launchpad strategy, UX design, governance, and Fiori application development" textAlign="Center" class="sapUiTinyMarginTop"/>
                                <Link text="Learn more" press=".onNavigateTo('fiori')" class="sapUiSmallMarginTop"/>
                            </VBox>
                        </l:BlockLayoutCell>
                        <l:BlockLayoutCell
                                backgroundColorSet="ColorSet10"
                                backgroundColorShade="ShadeE">
                            <VBox alignItems="Center">
                                <Avatar src="sap-icon://connected" displaySize="XL" press=".onNavigateTo('mcp')" displayShape="Circle" showBorder="true" tooltip="SAP MCP Server">
                                </Avatar>
                                <Title width="100%"
                                        text="SAP MCP Server"
                                        level="H4"
                                        titleStyle="H4"
                                        wrapping="true"
                                        class="sapUiSmallMarginTop"/>
                                <Text text="Connect any SAP system with AI agents using the Model Context Protocol" textAlign="Center" class="sapUiTinyMarginTop"/>
                                <Link text="Learn more" press=".onNavigateTo('mcp')" class="sapUiSmallMarginTop"/>
                            </VBox>
                        </l:BlockLayoutCell>
                    </l:BlockLayoutRow>
                </l:BlockLayout>
            </Panel>
            <Panel	accessibleRole="Region"
                    backgroundDesign="Transparent"
                    class="sapUiNoContentPadding">
                <headerToolbar>
                    <Toolbar class="headlineCell">
                        <Title width="100%"
                            text="How I Can Help"
                            level="H3"
                            titleStyle="H3"
                            class="sapUiMediumMarginTopBottom"/>
                    </Toolbar>
                </headerToolbar>
                <l:BlockLayout>
                    <l:BlockLayoutRow>
                        <l:BlockLayoutCell
                            backgroundColorSet="ColorSet10"
                            backgroundColorShade="ShadeB">
                            <FlexBox
                                alignItems="Start"
                                justifyContent="Center"
                                class="sapUiMediumMarginTopBottom">
                                <l:Grid
                                    defaultSpan="XL4 L6 M6 S12"
                                    hSpacing="1"
                                    vSpacing="0"
                                    width="100%" >
                                    <HBox width="100%" justifyContent="Center">
                                        <HBox width="20rem" justifyContent="Start" alignItems="Stretch" class="sapUiSmallMarginTopBottom">
                                            <VBox justifyContent="Start" alignItems="Center">
                                                <Avatar src="sap-icon://physical-activity" displaySize="M" displayShape="Circle" showBorder="false"/>
                                            </VBox>
                                            <VBox justifyContent="Start" alignItems="Stretch" class="sapUiTinyMarginBegin">
                                                <Title text="Architecture &amp; Strategy"/>
                                                <Text text="Define your BTP landscape, Fiori strategy, and technical roadmap aligned with your business goals."/>
                                            </VBox>
                                        </HBox>
                                    </HBox>
                                    <HBox width="100%" justifyContent="Center">
                                        <HBox width="20rem" justifyContent="Start" alignItems="Stretch" class="sapUiSmallMarginTopBottom">
                                            <VBox justifyContent="Start" alignItems="Center">
                                                <Avatar src="sap-icon://syntax" displaySize="M" displayShape="Circle" showBorder="false"/>
                                            </VBox>
                                            <VBox justifyContent="Start" alignItems="Stretch" class="sapUiTinyMarginBegin">
                                                <Title text="Development"/>
                                                <Text text="Build applications using CAP, UI5, Fiori Elements, and ABAP RAP. From proof of concept to production."/>
                                            </VBox>
                                        </HBox>
                                    </HBox>
                                    <HBox width="100%" justifyContent="Center">
                                        <HBox width="20rem" justifyContent="Start" alignItems="Stretch" class="sapUiSmallMarginTopBottom">
                                            <VBox justifyContent="Start" alignItems="Center">
                                                <Avatar src="sap-icon://learning-assistant" displaySize="M" displayShape="Circle" showBorder="false"/>
                                            </VBox>
                                            <VBox justifyContent="Start" alignItems="Stretch" class="sapUiTinyMarginBegin">
                                                <Title text="Mentoring &amp; Training"/>
                                                <Text text="Upskill your team on BTP technologies. Knowledge transfer, code reviews, and best practices coaching."/>
                                            </VBox>
                                        </HBox>
                                    </HBox>
                                    <HBox width="100%" justifyContent="Center">
                                        <HBox width="20rem" justifyContent="Start" alignItems="Stretch" class="sapUiSmallMarginTopBottom">
                                            <VBox justifyContent="Start" alignItems="Center">
                                                <Avatar src="sap-icon://official-service" displaySize="M" displayShape="Circle" showBorder="false"/>
                                            </VBox>
                                            <VBox justifyContent="Start" alignItems="Stretch" class="sapUiTinyMarginBegin">
                                                <Title text="Governance &amp; Best Practices"/>
                                                <Text text="Establish governance frameworks, naming conventions, security standards, and development guidelines."/>
                                            </VBox>
                                        </HBox>
                                    </HBox>
                                    <HBox width="100%" justifyContent="Center">
                                        <HBox width="20rem" justifyContent="Start" alignItems="Stretch" class="sapUiSmallMarginTopBottom">
                                            <VBox justifyContent="Start" alignItems="Center">
                                                <Avatar src="sap-icon://combine" displaySize="M" displayShape="Circle" showBorder="false"/>
                                            </VBox>
                                            <VBox justifyContent="Start" alignItems="Stretch" class="sapUiTinyMarginBegin">
                                                <Title text="Integration"/>
                                                <Text text="Connect BTP with on-premise systems and cloud solutions. Cloud Connector setup, destination configuration, and API management."/>
                                            </VBox>
                                        </HBox>
                                    </HBox>
                                    <HBox width="100%" justifyContent="Center">
                                        <HBox width="20rem" justifyContent="Start" alignItems="Stretch" class="sapUiSmallMarginTopBottom">
                                            <VBox justifyContent="Start" alignItems="Center">
                                                <Avatar src="sap-icon://developer-settings" displaySize="M" displayShape="Circle" showBorder="false"/>
                                            </VBox>
                                            <VBox justifyContent="Start" alignItems="Stretch" class="sapUiTinyMarginBegin">
                                                <Title text="DevOps &amp; CI/CD"/>
                                                <Text text="Set up automated pipelines, testing strategies, and transport management for your BTP applications."/>
                                            </VBox>
                                        </HBox>
                                    </HBox>
                                </l:Grid>
                            </FlexBox>
                        </l:BlockLayoutCell>
                    </l:BlockLayoutRow>
                </l:BlockLayout>
            </Panel>
            <Panel	accessibleRole="Region"
                    backgroundDesign="Transparent"
                    class="sapUiNoContentPadding">
                <l:BlockLayout>
                    <l:BlockLayoutRow>
                        <l:BlockLayoutCell
                            backgroundColorSet="ColorSet10"
                            backgroundColorShade="ShadeC">
                            <VBox alignItems="Center" class="sapUiMediumMarginTopBottom">
                                <Title text="Ready to discuss your project?" level="H3" class="sapUiSmallMarginBottom"/>
                                <Text text="Whether you need architectural guidance, hands-on development, or team mentoring, I'm here to help." class="sapUiSmallMarginBottom" textAlign="Center"/>
                                <Button text="Get in Touch" type="Emphasized" press=".onContact" icon="sap-icon://email" class="sapUiMediumMarginTop"/>
                            </VBox>
                        </l:BlockLayoutCell>
                    </l:BlockLayoutRow>
                    <l:BlockLayoutRow>
                        <l:BlockLayoutCell
                            backgroundColorSet="ColorSet10"
                            backgroundColorShade="ShadeE">
                            <VBox alignItems="Center">
                            </VBox>
                        </l:BlockLayoutCell>
                    </l:BlockLayoutRow>
                </l:BlockLayout>
            </Panel>
             </l:VerticalLayout>
                </l:Grid>
        </f:content>
    </f:DynamicPage>
</mvc:View>
